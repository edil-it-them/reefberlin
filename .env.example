# Database: local file in dev, Turso (libSQL) in production
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Initial admin password. Once the admin changes it in /admin/settings, the stored hash wins.
# Developer reset: run `npm run admin:reset`, then the value below applies again.
ADMIN_PASSWORD=

# Random string (>= 32 chars) used to sign admin session cookies: `openssl rand -hex 32`
SESSION_SECRET=

# Cloudflare Turnstile (defaults below are Cloudflare's always-pass test keys; use real ones in production)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
